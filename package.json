{
  "name": "propflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": ">=2.11.0",
      "browserslist": ">=4.28.7",
      "source-map-js": ">=1.2.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "esbuild@<=0.24.2": "^0.25.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/dedupe-server-chunks.mjs",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts --project unit",
    "test:unit:watch": "vitest --config vitest.config.ts --project unit",
    "test:unit:coverage": "vitest run --config vitest.config.ts --project unit --coverage",
    "test:rls": "vitest run tests/rls --config vitest.config.ts --project unit",
    "test:i18n": "vitest run tests/unit/i18n --config vitest.config.ts --project unit",
    "test:sql": "vitest run --config vitest.config.ts --project sql",
    "test:e2e": "playwright test",
    "e2e:s3": "docker run -d --rm --name propflow-e2e-s3 -p 9090:9090 -e COM_ADOBE_TESTING_S3MOCK_STORE_INITIAL_BUCKETS=propflow-files adobe/s3mock@sha256:468ba0b0e87f20ad54fbb6085e98c143f5bd1e384a844fa12a58535b4e39d4aa",
    "e2e:prepare": "wrangler d1 migrations apply propflow-db --local && node scripts/e2e/seed-d1.mjs && opennextjs-cloudflare build",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:unit",
    "seed": "npx tsx scripts/seed.ts",
    "agent:eval": "tsx scripts/agent-eval/run.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:size": "node scripts/check-worker-size.mjs .open-next",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --strict-vars=false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@react-pdf/renderer": "^4.9.0",
    "@types/papaparse": "^5.5.2",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.3",
    "papaparse": "^5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@opennextjs/cloudflare": "1.20.17",
    "@playwright/test": "^1.65.1",
    "@swc/helpers": "^0.5.24",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^31.0.1",
    "postgres": "^4.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "@parcel/watcher@2.5.6": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
