{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/airtable-sync",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "app/api/**": {
      "maxDuration": 60
    }
  }
}
