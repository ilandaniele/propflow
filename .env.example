# =============================================================================
# propflow — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git. .env.example is safe to commit (no real values).
#
# Variables marked PUBLIC are safe to expose in browser bundles (NEXT_PUBLIC_ prefix).
# Variables marked SERVER-ONLY must NEVER be used in Client Components or given a
# NEXT_PUBLIC_ prefix. Exposure of SERVER-ONLY values is a critical security incident.
#
# Production values: set these in Fly.io via `fly secrets set KEY=value --app propflow-app`.
# Local dev: copy to .env.local and fill in real values.
# =============================================================================

# --- Database (Fly.io Postgres) ---
# SERVER-ONLY — Drizzle ORM connection string. Provided by Fly.io after `flyctl postgres create`.
# Local dev: use the Fly.io connection string or a local Postgres instance.
# Format: postgresql://user:password@fly-postgres-host:5432/propflow
DATABASE_URL=postgresql://propflow:password@propflow-db.flycast:5432/propflow

# --- NextAuth v5 ---
# SERVER-ONLY — Required for NextAuth session signing and encryption.
# Generate with: openssl rand -base64 32
# Must be at least 32 characters. Set in fly secrets set KEY=value --app propflow-app.
AUTH_SECRET=your-32-char-random-secret-here

# --- Google OAuth ---
# SERVER-ONLY — Obtain from Google Cloud Console → APIs & Services → Credentials.
# Redirect URI to register: https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# --- NextAuth canonical URL ---
# SERVER-ONLY — Must match your deployment URL exactly.
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXTAUTH_URL=https://your-app.vercel.app

# --- Tigris Object Storage (S3-compatible, Fly-native) ---
# ALL Tigris variables are SERVER-ONLY. NEVER add NEXT_PUBLIC_ prefix to any of them.
# Exposure of TIGRIS_ACCESS_KEY_ID or TIGRIS_SECRET_ACCESS_KEY is a critical security incident.
#
# Setup steps (human):
#   1. flyctl storage create propflow-receipts propflow-unit-images propflow-tenant-avatars \
#          propflow-incident-photos propflow-task-proofs propflow-contracts
#   2. flyctl storage credentials create propflow-receipts  (use the same credentials for all buckets)
#   3. flyctl secrets set \
#          TIGRIS_ENDPOINT=https://fly.storage.tigris.dev \
#          TIGRIS_ACCESS_KEY_ID=<tid_...> \
#          TIGRIS_SECRET_ACCESS_KEY=<tsec_...> \
#          AWS_REGION=auto \
#          TIGRIS_BUCKET_RECEIPTS=propflow-receipts \
#          TIGRIS_BUCKET_UNIT_IMAGES=propflow-unit-images \
#          TIGRIS_BUCKET_TENANT_AVATARS=propflow-tenant-avatars \
#          TIGRIS_BUCKET_INCIDENT_PHOTOS=propflow-incident-photos \
#          TIGRIS_BUCKET_TASK_PROOFS=propflow-task-proofs \
#          TIGRIS_BUCKET_CONTRACTS=propflow-contracts

# SERVER-ONLY — Tigris S3-compatible endpoint (always https://fly.storage.tigris.dev for Fly.io)
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev

# SERVER-ONLY — Tigris access key ID (starts with "tid_")
TIGRIS_ACCESS_KEY_ID=tid_your_access_key_id_here

# SERVER-ONLY — Tigris secret access key (starts with "tsec_")
TIGRIS_SECRET_ACCESS_KEY=tsec_your_secret_access_key_here

# SERVER-ONLY — AWS region (use "auto" for Tigris; it routes to the nearest Fly region)
AWS_REGION=auto

# SERVER-ONLY — Physical bucket names in Tigris (logical → physical mapping).
# Each var maps a logical bucket name (used in code) to the actual Tigris bucket.
# Create these buckets with: flyctl storage create <bucket-name>
TIGRIS_BUCKET_RECEIPTS=propflow-receipts
TIGRIS_BUCKET_UNIT_IMAGES=propflow-unit-images
TIGRIS_BUCKET_TENANT_AVATARS=propflow-tenant-avatars
TIGRIS_BUCKET_INCIDENT_PHOTOS=propflow-incident-photos
TIGRIS_BUCKET_TASK_PROOFS=propflow-task-proofs
TIGRIS_BUCKET_CONTRACTS=propflow-contracts

# --- Site base URL ---
# PUBLIC — used for absolute URL construction in auth redirect emails
# (e.g. password reset, email confirmation). Must match the deployment URL exactly.
# Local: http://localhost:3000
# Staging: https://propflow-staging.vercel.app  (or your actual Vercel subdomain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sentry DSN ---
# SERVER-ONLY (the DSN is not a secret per Sentry docs, but there is no need to
# expose it in client bundles — wire it only through the Sentry server SDK unless
# you explicitly need browser-side Sentry, in which case add NEXT_PUBLIC_ variant).
# Optional for MVP staging; recommended before any production traffic.
# Found in: Sentry → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- CSP Report URI ---
# SERVER-ONLY (used in next.config.ts Content-Security-Policy header construction).
# Optional. If set, browsers will POST CSP violation reports to this endpoint.
# You can use https://report-uri.com free tier or your own endpoint.
CSP_REPORT_URI=https://your-report-uri-endpoint.example.com/csp-report

# =============================================================================
# Phase 2 — Payment & Financial Intelligence, Contract Completion,
#            Operations Automation, Community & Security
# =============================================================================
# All keys below are SERVER-ONLY. Never give them a NEXT_PUBLIC_ prefix.

# --- Anthropic API key ---
# SERVER-ONLY — used for receipt OCR (Claude vision) and the AI property
# insights assistant. Create at: https://console.anthropic.com/
# Owner step: paste this value into fly secrets set KEY=value --app propflow-app
#             (apply to Preview + Production environments).
# Cost note: usage-billed; per-user/org request caps protect spend.
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend API key ---
# SERVER-ONLY — transactional email (signature requests, reminders, announcements).
# Create at: https://resend.com/ (free tier: 3,000 emails/mo, 100/day).
# Owner step: create account, verify a sender domain (or use Resend sandbox sender
#             for staging), paste key into Vercel env.
RESEND_API_KEY=re_...

# --- Resend from-address ---
# SERVER-ONLY — sender address for all outgoing emails.
# Use your verified domain (e.g. noreply@yourdomain.com) or the Resend sandbox
# sender (onboarding@resend.dev) for staging.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Cron secret ---
# SERVER-ONLY — bearer token for POST /api/cron/reminders.
# Fly.io cron (or external scheduler) sends this in the Authorization header (Bearer <value>).
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-32-byte-secret-here

# =============================================================================
# Phase 4 — Tenant Detail, i18n, WhatsApp, Tasks, Sanctions, Automation
# =============================================================================

# --- WhatsApp webhook secret ---
# SERVER-ONLY — used to validate incoming WhatsApp webhook signatures (HMAC-SHA256).
# Generate with: openssl rand -hex 32
# Owner step: set in fly secrets set KEY=value --app propflow-app (Preview + Production).
# If not set, the webhook returns 503 to prevent silent failures in preview deployments.
# Default provider: mock (no real network calls). Set WHATSAPP_PROVIDER=meta|twilio for prod.
WHATSAPP_WEBHOOK_SECRET=your-random-32-byte-hex-secret

# --- WhatsApp provider ---
# SERVER-ONLY — controls which WhatsApp provider implementation is used.
# Defaults to 'mock' if not set. Set to 'meta' in prod to enable Meta Cloud API.
# WHATSAPP_PROVIDER=mock

# --- Meta Cloud API credentials (required when WHATSAPP_PROVIDER=meta) ---
# SERVER-ONLY. Obtain from Meta Business Manager → WhatsApp → API Setup.
# If any of these are absent when WHATSAPP_PROVIDER=meta, the app falls back
# to MockWhatsAppProvider and emits a log.warn with the list of missing keys.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# WHATSAPP_BUSINESS_ACCOUNT_ID=   # optional; only needed for downloadAttachment paths

# Note (Phase 5): The single-admin env var was removed. Recipients are now resolved
# from profiles.whatsapp_phone in the database (role=admin, whatsapp_phone IS NOT NULL).
# Populate profiles.whatsapp_phone for each admin who should receive weekly summaries.

# --- Password hashing (PBKDF2-SHA256 via WebCrypto) ---
# SERVER-ONLY. LEGACY_BCRYPT_VERIFY=1 lets existing bcrypt ($2a/$2b/$2y) users log in;
# their hash is transparently rehashed to PBKDF2 on success. Leave unset/0 to reject
# legacy hashes with PASSWORD_RESET_REQUIRED (e.g. on Cloudflare Workers Free).
LEGACY_BCRYPT_VERIFY=1
# Optional PBKDF2 iteration count for NEW hashes (integer >= 10000; default 100000).
# Stored hashes with fewer iterations are rehashed at next login.
PBKDF2_ITERATIONS=
