# =============================================================================
# propflow — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to git. .env.example is safe to commit (no real values).
#
# Variables marked PUBLIC are safe to expose in browser bundles (NEXT_PUBLIC_ prefix).
# Variables marked SERVER-ONLY must NEVER be used in Client Components or given a
# NEXT_PUBLIC_ prefix. Exposure of SERVER-ONLY values is a critical security incident.
#
# Staging values: set these in Vercel → Project → Settings → Environment Variables.
# Apply to the "Preview" and "Production" environments as appropriate.
# =============================================================================

# --- Supabase project URL ---
# PUBLIC — used by both browser client and server client.
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# --- Supabase anon (public) key ---
# PUBLIC — safe to expose; access is gated by Row Level Security policies.
# Found in: Supabase Dashboard → Project Settings → API → Project API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_PLACEHOLDER

# --- Supabase service-role key ---
# SERVER-ONLY — bypasses Row Level Security. NEVER expose to the browser.
# NEVER use as NEXT_PUBLIC_*. Used only in seed scripts, migrations, and
# privileged server-side paths (e.g. admin provisioning). CI/CD pipelines
# that run migrations also need this value set as a GitHub Actions secret.
# Found in: Supabase Dashboard → Project Settings → API → Project API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_PLACEHOLDER

# --- Direct Postgres connection URL ---
# SERVER-ONLY — used exclusively by the Supabase CLI and migration tooling.
# Use the direct (non-pooled) connection string for migrations; the pooled
# string (with "-pooler" in the host) is for application query traffic.
# Found in: Supabase Dashboard → Project Settings → Database → Connection String → URI
# Format: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgres://postgres.your-project-ref:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Site base URL ---
# PUBLIC — used for absolute URL construction in auth redirect emails
# (e.g. password reset, email confirmation). Must match the deployment URL exactly.
# Local: http://localhost:3000
# Staging: https://propflow-staging.vercel.app  (or your actual Vercel subdomain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sentry DSN ---
# SERVER-ONLY (the DSN is not a secret per Sentry docs, but there is no need to
# expose it in client bundles — wire it only through the Sentry server SDK unless
# you explicitly need browser-side Sentry, in which case add NEXT_PUBLIC_ variant).
# Optional for MVP staging; recommended before any production traffic.
# Found in: Sentry → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- CSP Report URI ---
# SERVER-ONLY (used in next.config.ts Content-Security-Policy header construction).
# Optional. If set, browsers will POST CSP violation reports to this endpoint.
# You can use https://report-uri.com free tier or your own endpoint.
CSP_REPORT_URI=https://your-report-uri-endpoint.example.com/csp-report

# =============================================================================
# Phase 2 — Payment & Financial Intelligence, Contract Completion,
#            Operations Automation, Community & Security
# =============================================================================
# All keys below are SERVER-ONLY. Never give them a NEXT_PUBLIC_ prefix.

# --- Anthropic API key ---
# SERVER-ONLY — used for receipt OCR (Claude vision) and the AI property
# insights assistant. Create at: https://console.anthropic.com/
# Owner step: paste this value into Vercel → Project → Settings → Env Vars
#             (apply to Preview + Production environments).
# Cost note: usage-billed; per-user/org request caps protect spend.
ANTHROPIC_API_KEY=sk-ant-...

# --- Resend API key ---
# SERVER-ONLY — transactional email (signature requests, reminders, announcements).
# Create at: https://resend.com/ (free tier: 3,000 emails/mo, 100/day).
# Owner step: create account, verify a sender domain (or use Resend sandbox sender
#             for staging), paste key into Vercel env.
RESEND_API_KEY=re_...

# --- Resend from-address ---
# SERVER-ONLY — sender address for all outgoing emails.
# Use your verified domain (e.g. noreply@yourdomain.com) or the Resend sandbox
# sender (onboarding@resend.dev) for staging.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Cron secret ---
# SERVER-ONLY — bearer token for POST /api/cron/reminders.
# Vercel Cron sends this in the Authorization header (Bearer <value>).
# Generate with: openssl rand -base64 32
# Owner step: set this in Vercel project env AND in the Vercel Cron configuration.
# Note: Vercel Hobby plan cron min granularity is daily (0 8 * * * = 08:00 UTC).
#       Sub-daily cadence requires Vercel Pro.
CRON_SECRET=your-random-32-byte-secret-here

# =============================================================================
# Phase 4 — Tenant Detail, i18n, WhatsApp, Tasks, Sanctions, Automation
# =============================================================================

# --- WhatsApp webhook secret ---
# SERVER-ONLY — used to validate incoming WhatsApp webhook signatures (HMAC-SHA256).
# Generate with: openssl rand -hex 32
# Owner step: set in Vercel → Project → Settings → Env Vars (Preview + Production).
# If not set, the webhook returns 503 to prevent silent failures in preview deployments.
# Default provider: mock (no real network calls). Set WHATSAPP_PROVIDER=meta|twilio for prod.
WHATSAPP_WEBHOOK_SECRET=your-random-32-byte-hex-secret

# --- WhatsApp provider ---
# SERVER-ONLY — controls which WhatsApp provider implementation is used.
# Defaults to 'mock' if not set. Set to 'meta' in prod to enable Meta Cloud API.
# WHATSAPP_PROVIDER=mock

# --- Meta Cloud API credentials (required when WHATSAPP_PROVIDER=meta) ---
# SERVER-ONLY. Obtain from Meta Business Manager → WhatsApp → API Setup.
# If any of these are absent when WHATSAPP_PROVIDER=meta, the app falls back
# to MockWhatsAppProvider and emits a log.warn with the list of missing keys.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# WHATSAPP_BUSINESS_ACCOUNT_ID=   # optional; only needed for downloadAttachment paths

# Note (Phase 5): The single-admin env var was removed. Recipients are now resolved
# from profiles.whatsapp_phone in the database (role=admin, whatsapp_phone IS NOT NULL).
# Populate profiles.whatsapp_phone for each admin who should receive weekly summaries.

# =============================================================================
# Airtable read-only integration (W2/W3 — Phase 6)
# =============================================================================
# ALL Airtable variables are SERVER-ONLY. NEVER add NEXT_PUBLIC_ prefix to any of them.
# Exposure of these values is a security incident — Airtable PATs grant API-level access.
#
# Setup steps (human):
#   1. Open Airtable → Account → Developer Hub → Personal Access Tokens → Create token
#   2. Grant read-only scopes: data.records:read, schema.bases:read
#   3. Scope the token to the specific base only (principle of least privilege)
#   4. Set all five vars in Vercel → Project → Settings → Environment Variables
#      (apply to BOTH Production and Preview environments)
#
# To find AIRTABLE_BASE_ID: open your base in Airtable → the URL is
#   https://airtable.com/appXXXXXXXXXXXXXX/tblYYYYYYYYYYYYYY/...
#   The appXXXXX portion is AIRTABLE_BASE_ID; tblYYYYY is a table id.
# Table IDs (tblXXX) and table names are interchangeable in the REST API.

# --- Airtable Personal Access Token ---
# SERVER-ONLY. Never commit a real PAT — it grants full read access to your Airtable base.
AIRTABLE_PAT=pat.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Airtable base ID ---
# SERVER-ONLY. Found in the Airtable URL: https://airtable.com/appXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# --- Airtable table identifiers ---
# SERVER-ONLY. Use either the table's human-readable name (e.g. "Rooms") or its
# ID (e.g. "tblXXXXXXXXXXXXXX") — both work with the REST API.
AIRTABLE_TABLE_ROOMS=Rooms
AIRTABLE_TABLE_PERFORMANCE=Room Performance
AIRTABLE_TABLE_KPIS=KPIs
