# =============================================================================
# propflow — Environment Variables (Cloudflare Workers stack)
# =============================================================================
# Placeholders only. NEVER commit real values.
#
# Local dev: copy this file to .env.local (Next.js) and, for values the Worker
# reads from its environment, to .dev.vars (gitignored; read by wrangler and by
# `next dev` through initOpenNextCloudflareForDev). The D1 database (binding DB)
# and R2 bucket (binding FILES) are bindings declared in wrangler.jsonc, not env vars.
#
# Production: secrets are set with `wrangler secret put NAME` (never in git).
# Non-secret vars live in wrangler.jsonc `vars` (WHATSAPP_PROVIDER, R2_BUCKET).
#
# Variables marked PUBLIC are safe in browser bundles (NEXT_PUBLIC_ prefix).
# Variables marked SERVER-ONLY must NEVER be given a NEXT_PUBLIC_ prefix or be
# used in Client Components. Exposure of a SERVER-ONLY value is a security incident.
# =============================================================================

# --- NextAuth v5 (database sessions on D1) ---
# SERVER-ONLY — session signing. Generate with: openssl rand -base64 32 (>= 32 chars).
AUTH_SECRET=your-32-char-random-secret-here

# SERVER-ONLY — canonical URL of the deployment (replaces the old NEXTAUTH_URL).
# Local: http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Google OAuth ---
# SERVER-ONLY — Google Cloud Console > APIs & Services > Credentials.
# Redirect URI to register: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# --- Site base URL ---
# PUBLIC — absolute URLs in emails/redirects and widget origin checks. Must match AUTH_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare R2 object storage (S3-compatible API) ---
# ALL R2 variables are SERVER-ONLY. The object key stored in the DB is the path itself
# (1:1 with the old Tigris keys); one physical bucket holds every logical bucket.
#
# Setup (owner, creates resources: needs approval):
#   1. Create the bucket `propflow-files` (and `propflow-files-staging`).
#   2. Dashboard > R2 > Manage API tokens: S3 token with Object Read & Write scoped to that bucket.
#   3. wrangler secret put R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_S3_ENDPOINT
R2_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Physical bucket name (defaults to propflow-files; set in wrangler.jsonc vars)
R2_BUCKET=propflow-files

# --- Cron ---
# SERVER-ONLY — bearer token for /api/cron/*. Cron Triggers call these routes
# in-process with it; the manual cron-dispatch workflow sends it over HTTP.
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-32-byte-secret-here

# --- Anthropic ---
# SERVER-ONLY — receipt OCR, AI insights and the WhatsApp leasing agent.
# Usage-billed; per-user/org request caps protect spend.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults are set in src/lib/ai/client.ts)
# AGENT_MODEL=
# AGENT_VOICE_MODEL=

# --- Workers AI (owner assistant voice notes) ---
# SERVER-ONLY, optional. Both set = WhatsApp voice notes are transcribed (usage-billed). Unset = voice off.
# WORKERS_AI_ACCOUNT_ID=
# WORKERS_AI_API_TOKEN=

# --- Resend (transactional email) ---
# SERVER-ONLY — https://resend.com/ . Verify a sender domain before production.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- WhatsApp ---
# SERVER-ONLY — webhook HMAC secret. Generate with: openssl rand -hex 32.
# If unset the webhook returns 503.
WHATSAPP_WEBHOOK_SECRET=your-random-32-byte-hex-secret
# Provider: mock | meta | twilio. wrangler.jsonc sets "meta". Defaults to mock if unset.
# WHATSAPP_PROVIDER=mock
# Meta Cloud API credentials (required when WHATSAPP_PROVIDER=meta; otherwise the
# app falls back to the mock provider and logs the missing keys).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# WHATSAPP_BUSINESS_ACCOUNT_ID=   # optional; only for downloadAttachment paths

# --- Voice agent (Vapi), optional ---
# SERVER-ONLY
# VAPI_API_KEY=
# VAPI_WEBHOOK_SECRET=
# VAPI_WEBHOOK_URL=

# --- Google Calendar sync, optional ---
# SERVER-ONLY — redirect URI defaults to NEXT_PUBLIC_SITE_URL + /api/calendar/google/callback.
# GOOGLE_CALENDAR_REDIRECT_URI=
# AES-256-GCM key for encrypting calendar refresh tokens at rest. Generate with: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=

# --- Admin access ---
# SERVER-ONLY — extra admin emails (comma-separated) on top of the static allowlist,
# and the owner whose organization allowlisted admins are provisioned into.
# ADMIN_ALLOWLIST=
# PRIMARY_OWNER_EMAIL=

# --- Password hashing (PBKDF2-SHA256 via WebCrypto) ---
# SERVER-ONLY. LEGACY_BCRYPT_VERIFY=1 lets existing bcrypt ($2a/$2b/$2y) users log in;
# their hash is rehashed to PBKDF2 on success. Leave unset/0 to reject legacy hashes
# with PASSWORD_RESET_REQUIRED (e.g. on Workers Free, where bcrypt exceeds the CPU limit).
LEGACY_BCRYPT_VERIFY=1
# Optional PBKDF2 iteration count for NEW hashes (integer >= 10000; default 100000).
PBKDF2_ITERATIONS=

# --- Observability / CSP ---
# SERVER-ONLY. Both optional.
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
CSP_REPORT_URI=https://your-report-uri-endpoint.example.com/csp-report

# =============================================================================
# MIGRATION ONLY — read by scripts/migrate-to-d1 and scripts/migrate-to-r2.
# Not used by the app at runtime. Delete this block after cutover (W-CF-60/55).
# Run these scripts locally, never in the Worker. Values are the OLD Fly stack.
# =============================================================================

# Source Postgres (scripts/migrate-to-d1 export/inventory). Also needs PRIMARY_OWNER_EMAIL above.
DATABASE_URL=postgresql://user:password@host:5432/propflow

# Source Tigris storage (scripts/migrate-to-r2/copy-objects.mjs and verify-objects.mjs).
# Destination is R2_S3_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET above.
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY_ID=your_tigris_access_key_id
TIGRIS_SECRET_ACCESS_KEY=your_tigris_secret_access_key
# Optional per-logical-bucket names (else STORAGE_BUCKET, else the logical name):
# TIGRIS_BUCKET_UNIT_IMAGES= TIGRIS_BUCKET_TENANT_AVATARS= TIGRIS_BUCKET_RECEIPTS=
# TIGRIS_BUCKET_INCIDENT_PHOTOS= TIGRIS_BUCKET_TASK_PROOFS= TIGRIS_BUCKET_CONTRACTS=
