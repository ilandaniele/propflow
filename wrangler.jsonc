{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "propflow-app",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "propflow-db",
      "database_id": "8f653248-ad53-48d7-82ac-208a03ce194c",
      "migrations_dir": "src/lib/db/migrations-d1"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "propflow-files" }],
  "ratelimits": [
    { "name": "RL_IP_API", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_IP_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "vars": {
    "WHATSAPP_PROVIDER": "meta",
    "AGENT_PROVIDER": "workers-ai",
    "AGENT_WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "R2_BUCKET": "propflow-files",
    "AUTH_URL": "https://propflow-app.ilandaniele.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://propflow-app.ilandaniele.workers.dev"
  }
}
